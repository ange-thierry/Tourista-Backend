# Copy to `.env` and adjust. Every value is optional in development.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend origins allowed to call the API directly (the Vite proxy doesn't need this).
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Links in emails (verify email, reset password) point here
FRONTEND_URL=http://localhost:8080

# Email: without EMAIL_HOST, emails are printed in the runserver terminal
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Tourista Rwanda <no-reply@tourista.rw>
# Who gets contact-form / demo-request alerts (default: admin accounts)
# STAFF_NOTIFICATION_EMAILS=team@tourista.rw

# Refresh-token cookie. Use SameSite=None (+ HTTPS) only if the frontend is on another site.
# REFRESH_COOKIE_SAMESITE=Lax
# REFRESH_COOKIE_SECURE=false

# Max image upload size
# UPLOAD_MAX_MB=5

# JWT lifetimes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Password for the accounts created by `python manage.py seed_demo`
DEMO_PASSWORD=Tourista@2026

# Use PostgreSQL instead of SQLite (also `pip install "psycopg[binary]"`)
# POSTGRES_DB=tourista
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
